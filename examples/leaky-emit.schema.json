{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": { "type": "string", "maxLength": 80 },
    "status": { "type": "string", "enum": ["draft", "ready"] },
    "points": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string", "maxLength": 200 }
    }
  },
  "required": ["title", "status", "points"],
  "additionalProperties": false
}
